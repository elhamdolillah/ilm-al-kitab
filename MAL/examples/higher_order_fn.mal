// ═══════════════════════════════════════════════════════════
// مثال دلالي: دوال الرتبة العليا (Higher-Order Functions)
// يوضح هذا المثال تمرير دالة كمتغير (مثل دالة تنشيط في شبكة عصبية)
// ═══════════════════════════════════════════════════════════
// دالة تأخذ دالة أخرى (f) وقيمة (x) وتطبق f على x
fn apply_fn(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}
// دالة تنشيط بسيطة (مثال: مضاعفة القيمة)
fn double_val(x: i32) -> i32 {
    return x * 2;
}
fn main() -> i32 {
    let input: i32 = 5;
    // تمرير الدالة double_val كمتغير من الرتبة العليا
    let result = apply_fn(double_val, input);
    printf("نتيجة تطبيق الدالة على %d هي: %d\n", input, result);
    return 0;
}
