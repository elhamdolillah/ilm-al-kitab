fn factorial(n: i32) -> i32 {
    if (n <= 1) return 1;
    let result: i32 = 1;
    let i: i32 = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}
fn main() -> i32 {
    printf("5! = %d\n", factorial(5));
    printf("10! = %d\n", factorial(10));
    return 0;
}
