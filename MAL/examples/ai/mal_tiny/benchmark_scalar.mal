fn main() -> i32 {
    printf("🚀 بدء اختبار الأداء بلغة MAL (10,000,000 تكرار)\n");
    let mut a: i32 = 1;
    let mut i: i32 = 0;
    let start_time: i64 = get_time_ms();
    while i < 10000000 {
        a = a * 3 + 1;
        i = i + 1;
    }
    let end_time: i64 = get_time_ms();
    let duration: i64 = end_time - start_time;
    printf("✅ اكتمل الاختبار بنجاح!\n");
    printf("⏱️ الوقت الإجمالي: %d ميلي ثانية\n", duration);
    printf("📊 القيمة النهائية: %d\n", a);
    return 0;
}
