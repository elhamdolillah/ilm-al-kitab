fn is_prime(n: i32) -> i32 {
    if (n < 2) return 0;
    if (n == 2) return 1;
    if (n % 2 == 0) return 0;
    let i: i32 = 3;
    while (i * i <= n) {
        if (n % i == 0) return 0;
        i = i + 2;
    }
    return 1;
}
fn main() -> i32 {
    printf("Primes under 30: ");
    let i: i32 = 2;
    while (i < 30) {
        if (is_prime(i) == 1) {
            printf("%d ", i);
        }
        i = i + 1;
    }
    printf("\n");
    return 0;
}
